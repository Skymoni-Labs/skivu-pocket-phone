{
  "schemaVersion": 1,
  "apiVersion": "1.0",
  "id": "org.skivu.pocket-phone",
  "name": "角色小手机",
  "version": "1.3.0",
  "minHostVersion": "0.2.39",
  "author": "Skivu contributors",
  "description": "角色自己的小手机：连贯生活近况、角色聊天与存档，真实音乐、书目、RSS 和系统软件链接。",
  "license": "GPL-3.0-only",
  "source": "https://github.com/skyjjgw/skivu-pocket-phone",
  "entry": "index.html",
  "permissions": [
    "storage",
    "files",
    "secrets",
    "network",
    "network.local",
    "ai.generate",
    "chat.read",
    "chat.write",
    "external.open"
  ],
  "networkDomains": [
    "*"
  ],
  "contributes": {
    "launcher": true,
    "chatSurface": true,
    "chatActions": [
      {
        "id": "open-phone",
        "title": "打开角色小手机"
      },
      {
        "id": "update-phone",
        "title": "更新角色的小手机"
      },
      {
        "id": "chat-phone",
        "title": "与角色聊天并使用小手机"
      }
    ]
  }
}
